#: xfce4-panel-profiles/xfce4-panel-profiles.py:489
#, python-format
msgid ""
"The file already exists in \"%s\", replacing it will overwrite its contents."
msgstr ""
"Fitxategia badago dagoeneko \"%s\" karpetan; ordezten baduzu, haren edukia "
"gainidatziko da."

#: xfce4-panel-profiles/xfce4-panel-profiles.py:491
msgid "Replace"
msgstr "Ordeztu"

#: data/metainfo/org.xfce.PanelProfiles.appdata.xml.in:6
msgid "Xfce Panel Profiles"
msgstr "Xfce panel-profilak"

#: data/metainfo/org.xfce.PanelProfiles.appdata.xml.in:7
msgid "Application to manage different panel layouts in Xfce"
msgstr "Xfce-n panelen diseinu desberdinak kudeatzeko aplikazioa"

#: data/metainfo/org.xfce.PanelProfiles.appdata.xml.in:11
msgid ""
"Multitude of panel layouts can be created using Xfce panel. This tool "
"enables managing different layouts with little effort. Xfce4-panel-profiles "
"makes it possible to backup, restore, import and export panel layouts."
msgstr ""
"Xfce panelarekin panel-diseinu ugari sor daitezke. Tresna honek diseinu "
"desberdinak ahalegin handirik gabe kudeatzeko aukera ematen du. Xfce4-panel-"
"profiles-ekin panelen diseinuen babeskopiak egin, leheneratu, inportatu eta "
"esportatu daitezke."
