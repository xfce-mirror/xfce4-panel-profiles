msgstr "_ຊ່ວຍເຫຼືອ"

#: xfce4-panel-profiles/xfce4-panel-profiles.glade:212
msgid "_About"
msgstr "_ກ່ຽວກັບ"

#: xfce4-panel-profiles/xfce4-panel-profiles.glade:227
msgid "_Close"
msgstr "_ປິດ"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:126
msgid "Current Configuration"
msgstr "ການຕັ້ງຄ່າປັດຈຸບັນ"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:144
msgid "Today"
msgstr "ມື້ນີ້"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:146
msgid "Yesterday"
msgstr "ມື້ວານນີ້"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:210
#, python-format
msgid "%s (Copy of %s)"
msgstr "%s (ສຳເນົາຂອງ %s)"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:228
msgid "Import configuration file..."
msgstr "ນຳເຂົ້າໄຟລ໌ການຕັ້ງຄ່າ..."

#: xfce4-panel-profiles/xfce4-panel-profiles.py:231
#: xfce4-panel-profiles/xfce4-panel-profiles.py:342
#: xfce4-panel-profiles/xfce4-panel-profiles.py:385
#: xfce4-panel-profiles/xfce4-panel-profiles.py:412
#: xfce4-panel-profiles/xfce4-panel-profiles.py:465
#: xfce4-panel-profiles/xfce4-panel-profiles.py:490
msgid "Cancel"
msgstr "ຍົກເລີກ"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:232
msgid "Open"
msgstr "ເປີດ"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:246
msgid ""
"Invalid configuration file!\n"
"Please select a valid configuration file."
msgstr ""
"ໄຟລ໌ການຕັ້ງຄ່າບໍ່ຖືກຕ້ອງ!\n"
"ກະລຸນາເລືອກໄຟລ໌ການຕັ້ງຄ່າທີ່ຖືກຕ້ອງ."

#: xfce4-panel-profiles/xfce4-panel-profiles.py:254
msgid "OK"
msgstr "ຕົກລົງ"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:336
msgid "Name the new panel configuration"
msgstr "ຕັ້ງຊື່ການຕັ້ງຄ່າແຜງໃໝ່"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:360
#, python-format
msgid "Backup_%s"
msgstr "ສຳຮອງ_%s"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:376
msgid ""
"Do you want to apply this configuration?\n"
" The current configuration will be lost!"
msgstr ""
"ທ່ານຕ້ອງການນຳໃຊ້ການຕັ້ງຄ່ານີ້ບໍ?\n"
" ການຕັ້ງຄ່າປັດຈຸບັນຈະຫາຍໄປ!"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:393
msgid "Make a backup of the current configuration"
msgstr "ສ້າງການສຳຮອງຂໍ້ມູນການຕັ້ງຄ່າປັດຈຸບັນ"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:404
msgid "Errors occurred while parsing the current configuration."
msgstr "ເກີດຂໍ້ຜິດພາດໃນຂະນະທີ່ກວດສອບການຕັ້ງຄ່າປັດຈຸບັນ."

#: xfce4-panel-profiles/xfce4-panel-profiles.py:413
#: xfce4-panel-profiles/xfce4-panel-profiles.py:469
msgid "Save"
msgstr "ບັນທຶກ"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:424
msgid ""
"Do you want to save despite the errors? Some configuration information could"
" be missing."
msgstr ""
"ທ່ານຕ້ອງການບັນທຶກເຖິງແມ່ນວ່າຈະມີຂໍ້ຜິດພາດບໍ? "
"ຂໍ້ມູນການຕັ້ງຄ່າບາງຢ່າງອາດຈະສູນຫາຍ."

#: xfce4-panel-profiles/xfce4-panel-profiles.py:432
msgid "Export configuration as..."
msgstr "ສົ່ງອອກການຕັ້ງຄ່າເປັນ..."

#: xfce4-panel-profiles/xfce4-panel-profiles.py:444
msgid "Untitled"
msgstr "ບໍ່ມີຫົວຂໍ້"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:452
msgid "Location"
msgstr "ສະຖານທີ່"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:456
msgid "Select a Folder"
msgstr "ເລືອກໂຟນເດີ"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:488
#, python-format
msgid "<b>A file named \"%s\" already exists. Do you want to replace it?</b>"
msgstr "<b>ມີໄຟລ໌ຊື່ \"%s\" ຢູ່ແລ້ວ. ທ່ານຕ້ອງການແທນທີ່ມັນບໍ?</b>"

#: xfce4-panel-profiles/xfce4-panel-profiles.py:489
#, python-format
msgid ""
"The file already exists in \"%s\", replacing it will overwrite its contents."
msgstr "ມີໄຟລ໌ນີ້ຢູ່ແລ້ວໃນ \"%s\", ການແທນທີ່ມັນຈະຂຽນທັບເນື້ອໃນທີ່ມີຢູ່."

#: xfce4-panel-profiles/xfce4-panel-profiles.py:491
msgid "Replace"
msgstr "ແທນທີ່"

#: data/metainfo/org.xfce.PanelProfiles.appdata.xml.in:6
msgid "Xfce Panel Profiles"
msgstr "ໂປຣໄຟລ໌ແຜງ Xfce"

#: data/metainfo/org.xfce.PanelProfiles.appdata.xml.in:7
msgid "Application to manage different panel layouts in Xfce"
msgstr "ແອັບພລິເຄຊັນສຳລັບຈັດການໂຄງຮ່າງແຜງຕ່າງໆໃນ Xfce"

#: data/metainfo/org.xfce.PanelProfiles.appdata.xml.in:11
msgid ""
"Multitude of panel layouts can be created using Xfce panel. This tool "
"enables managing different layouts with little effort. Xfce4-panel-profiles "
"makes it possible to backup, restore, import and export panel layouts."
msgstr ""
"ສາມາດສ້າງໂຄງຮ່າງແຜງໄດ້ຫຼາກຫຼາຍໂດຍໃຊ້ແຜງ Xfce. "
"ເຄື່ອງມືນີ້ຊ່ວຍໃຫ້ການຈັດການໂຄງຮ່າງຕ່າງໆເປັນໄປໄດ້ຢ່າງງ່າຍດາຍ. Xfce4-panel-"
"profiles ຊ່ວຍໃຫ້ສາມາດສຳຮອງ, ກູ້ຄືນ, ນຳເຂົ້າ ແລະ ສົ່ງອອກໂຄງຮ່າງແຜງໄດ້."
